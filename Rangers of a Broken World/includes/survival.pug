.specialty.survival
	.top.rhead
		+t("Survival Specialty:")
		+hidden("class").cshower
		+t("Urban/Ruins").infiltrator-class
		+t("Tundra").legionnaire-class
		+t("Nautical/Coastal").navigator-class
		+t("Tropical").tracker-class
		+t("High-Altitude").arcanist-class
		+t("Arid").magus-class
		+t("Boreal").cavalier-class
	.details
		+hidden("class").cshower
		.infiltrator-class
			.heavy
				+t("Street Stalker")
			.body
				+t("While in an Urban or Ruins environment, you start the Advantage Pool with 2 Successes in it.")
		.legionnaire-class
			.heavy
				+t("Clear as Ice")
			.body
				+t("While in a Tundra environment, you are immune to effects that would prevent you from using any of your facets.")
		.navigator-class
			.heavy
				+t("Cry of the Waves")
			.body
				+t("When you can hear the ocean’s soothing roar, you can make a Sensitivity/Focus roll every time you take 1 Hit to clear 1 Scatter for every Success.")
		.tracker-class
			.heavy
				+t("Vigilance")
			.body
				+t("While in a Tropical environment, you immediately and without rolling become aware of any hidden natural dangers in a scene, such as a pit, a toxic creature, or a dangerous plant.")
		.arcanist-class
			.heavy
				+t("Sheer Endurance")
			.body
				+t("While in a High-Altitude environment, you can force through pain and struggle forward. The first time you take a Hit, you may ignore the consequence until the Crisis ends.")
		.magus-class
			.heavy
				+t("Voice of the Desert Wind")
			.body
				+t("When trying to locate a place or creature in an Arid environment, roll two additional dice.")
		.cavalier-class
			.heavy
				+t("Surrounded by Life")
			.body
				+t("While in a Boreal environment, you cannot be forced to gain Scatter, and can gain Scatter up to 7.")
