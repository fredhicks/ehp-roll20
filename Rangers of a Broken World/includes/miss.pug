.miss
	+t("Miss Questions").rhead
	ul.misses
		li
			+t("How will this get worse?")
		li
			+t("Why was this approach wrong?")
		li.heavy
			+hidden("class").cshower
			.infiltrator-class
				+t("What opportunity is near?")
			.legionnaire-class
				+t("How could I have succeeded?")
			.navigator-class
				+t("Who could help me with this?")
			.tracker-class
				+t("What did I fail to notice?")
			.arcanist-class
				+t("Who or what caused this situation?")
			.magus-class
				+t("Where can I go to learn more?")
			.cavalier-class
				+t("Who is most hurt by this?")
