include abilitydata.pug
include translations.pug

mixin translations
	- var contents = JSON.stringify(translations,null,"\t");
	//
		translation.json:
		!{contents}

mixin t(text)
	- if ( typeof(translations[text]) == "undefined" ) { translations[text] = text; }
	span(data-i18n=text)&attributes(attributes) #{text}
	| 

mixin select(f)
	select(name='attr_'+f)&attributes(attributes)
		if block
			block

mixin option(t,v)
	- if ( typeof(translations[t]) == "undefined" ) { translations[t] = t; }
	if ( typeof(v) == "undefined" )
		option(value=t data-i18n=t)&attributes(attributes)
	else
		option(value=v data-i18n=t)&attributes(attributes)

mixin number(f)
	input(type='number' name='attr_'+f)&attributes(attributes)

mixin text(f)
	input(type='text' name='attr_'+f)&attributes(attributes)

mixin hidden(f)
	input(type='hidden' name='attr_'+f)&attributes(attributes)

mixin textarea(f)
	textarea(name='attr_'+f)&attributes(attributes)
		if block
			block

mixin display(f)
	span(name="attr_"+f)&attributes(attributes)
		if block
			block

mixin flabel(t)
	div.flabel
		+t(t)
		if block
			block

mixin fieldset(f)
	fieldset(class="repeating_"+f)
		if block
			block

// Hide or Show


mixin ahider(f)
	+hidden(f)(value="").ahider&attributes(attributes)

mixin ashower(f)
	+hidden(f)(value="").ashower&attributes(attributes)

mixin zhider(f)
	// Hide if Zero only
	+hidden(f)(value="0").thider&attributes(attributes)

mixin thider(f)
	+hidden("toggle_"+f)(value="0").thider&attributes(attributes)

mixin tshower(f)
	+hidden("toggle_"+f)(value="0").tshower&attributes(attributes)

mixin thiderMarked(f)
	+hidden("toggle_"+f)(value="1").thider&attributes(attributes)

mixin tshowerMarked(f)
	+hidden("toggle_"+f)(value="1").tshower&attributes(attributes)

// Toggleboxes

mixin sbox(f)
	+thider(f)
	button(type="action" name="act_unmark" value=f).starbox.marked
	+tshower(f)
	button(type="action" name="act_mark" value=f).starbox.unmarked

mixin sboxMarked(f)
	+thiderMarked(f)
	button(type="action" name="act_unmark" value=f).starbox.marked
	+tshowerMarked(f)
	button(type="action" name="act_mark" value=f).starbox.unmarked

mixin cbox(f)
	+thider(f)
	button(type="action" name="act_unmark" value=f).cbox.marked
	+tshower(f)
	button(type="action" name="act_mark" value=f).cbox.unmarked

// Shorthands

mixin skillmenu(n)
	+select("skill"+n)
		+option("(Skill)","")
		+option("Art")
		+option("Athletics")
		+option("Engineering")
		+option("Fashion")
		+option("Finances")
		+option("Focus")
		+option("Humanity")
		+option("Medicine")
		+option("Navigation")
		+option("Performance")
		+option("Politics")
		+option("Riding")
		+option("Spirits")
		+option("Survival")(disabled)
		+option("Survival (Arid)","Survival (Arid)")
		+option("Survival (Boreal)","Survival (Boreal)")
		+option("Survival (High-Altitude)","Survival (High-Altitude)")
		+option("Survival (Nautical)","Survival (Nautical)")
		+option("Survival (Tropical)","Survival (Tropical)")
		+option("Survival (Tundra)","Survival (Tundra)")
		+option("Survival (Urban/Ruins)","Survival (Urban/Ruins)")
		+option("Tactics")
		+option("Tinkering")
		+option("Tracking")
		+option("Weapons")(disabled)
		+option("Weapons")
		+option("Weapons (Melee)", "Weapons (Melee)")
		+option("Weapons (Mid-Range)", "Weapons (Mid-Range)")
		+option("Weapons (Long-Range)", "Weapons (Long-Range)")

mixin facetmenu(n)
	+select("facet"+n)
		+option("(Facet)","")
		+option("Adaptability")
		+option("Daring")
		+option("Sensitivity")
		+option("Subtlety")
		+option("Understanding")
